{
  "name": "@spencerquantro/agent-factory",
  "version": "0.5.0",
  "description": "Install a Claude Code software factory into any repo: GitHub issues → intake → spec → build → gate → review → PR.",
  "type": "module",
  "license": "GPL-3.0-only",
  "bin": {
    "agent-factory": "bin/agent-factory.mjs"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "index.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencerQuantro/agent-factory.git"
  },
  "keywords": [
    "claude-code",
    "software-factory",
    "agents",
    "github-issues",
    "automation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "agentFactory": {
    "upstream": "https://github.com/zazencodes/zazencodes-season-3/tree/94f7ae7b9dced7ffa87fb4a58312c89522ee120c/src/software-factory-claude-code-v2"
  }
}
