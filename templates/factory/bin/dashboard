#!/usr/bin/env python3
"""Serve factory/dashboard.html on localhost and open it in a browser.

Usage:
  dashboard                 start the server if it isn't running, then open the board
  dashboard --port <n>      prefer port n (default 8000; the next free port if taken)
  dashboard --no-open       start or find the server, print the URL, don't open a browser
  dashboard --stop          stop the server
  dashboard --status        print the URL if the server is running

The server is this script with `--serve`, bound to 127.0.0.1 only and detached
from this shell so it outlives the command. It serves read-only GETs of
dashboard.html and jobs/ and nothing else: no bin/, config or checks.sh, no
dotfiles, and no request whose Host header isn't this server's (which blocks
DNS rebinding from a web page). Its pid and port are kept in
factory/jobs/.dashboard.json (gitignored runtime state).
"""

import html
import io
import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import webbrowser
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
JOBS = FACTORY / "jobs"
STATE = JOBS / ".dashboard.json"
LOG = JOBS / ".dashboard.log"
HOST = "127.0.0.1"
DEFAULT_PORT = 8000
CSP = ("default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
       "connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; "
       "frame-ancestors 'none'")


def die(msg):
    print(f"dashboard: {msg}", file=sys.stderr)
    sys.exit(1)


def url(port):
    return f"http://{HOST}:{port}/dashboard.html"


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind((HOST, port))
            return True
        except OSError:
            return False


def serves_this_factory(port):
    """True when the server on `port` is serving this factory's dashboard."""
    try:
        with urllib.request.urlopen(url(port), timeout=1) as res:
            return res.status == 200 and b"factory/bin/job" in res.read()
    except OSError:
        return False


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def running():
    """The recorded server, if it's still up and still ours."""
    if not STATE.exists():
        return None
    try:
        state = json.loads(STATE.read_text())
    except ValueError:
        return None
    if alive(state.get("pid")) and serves_this_factory(state.get("port")):
        return state
    STATE.unlink(missing_ok=True)
    return None


def start(preferred):
    port = next((p for p in range(preferred, preferred + 100) if port_free(p)), None)
    if port is None:
        die(f"no free port in {preferred}-{preferred + 99}")
    JOBS.mkdir(exist_ok=True)
    with open(LOG, "ab") as log:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "--serve", str(port)],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )
    for _ in range(50):
        if proc.poll() is not None:
            die(f"the server exited with code {proc.returncode}; see {LOG}")
        if serves_this_factory(port):
            break
        time.sleep(0.1)
    else:
        proc.terminate()
        die(f"the server didn't answer on port {port}; see {LOG}")
    state = {"pid": proc.pid, "port": port}
    STATE.write_text(json.dumps(state) + "\n")
    return state


def stop():
    state = running()
    if not state:
        STATE.unlink(missing_ok=True)
        print("dashboard: not running")
        return
    os.killpg(state["pid"], signal.SIGTERM)
    STATE.unlink(missing_ok=True)
    print(f"dashboard: stopped (port {state['port']})")


def allowed_path(path):
    """dashboard.html and anything under jobs/, minus dotfiles (locks, state, logs)."""
    parts = [p for p in path.split("/") if p]
    if any(p.startswith(".") for p in parts):
        return False
    return parts == ["dashboard.html"] or parts[:1] == ["jobs"]


class Handler(SimpleHTTPRequestHandler):
    server_version = "factory-dashboard"
    sys_version = ""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(FACTORY), **kwargs)

    def end_headers(self):
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", CSP)
        super().end_headers()

    def check(self):
        port = self.server.server_address[1]
        if self.headers.get("Host", "") not in {f"{HOST}:{port}", f"localhost:{port}"}:
            self.send_error(403, "Forbidden host")
            return False
        path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
        if path == "/":
            self.send_response(302)
            self.send_header("Location", "/dashboard.html")
            self.end_headers()
            return False
        if not allowed_path(path):
            self.send_error(404)
            return False
        return True

    def do_GET(self):
        if self.check():
            super().do_GET()

    def do_HEAD(self):
        if self.check():
            super().do_HEAD()

    def list_directory(self, path):
        try:
            names = sorted(n for n in os.listdir(path) if not n.startswith("."))
        except OSError:
            self.send_error(404)
            return None
        links = []
        for name in names:
            href = name + "/" if os.path.isdir(os.path.join(path, name)) else name
            links.append(f'<li><a href="{urllib.parse.quote(href)}">{html.escape(href)}</a></li>')
        body = ("<!doctype html><meta charset=utf-8><ul>\n" + "\n".join(links) + "\n</ul>\n").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        return io.BytesIO(body)

    def log_message(self, fmt, *args):
        sys.stderr.write(f"{self.log_date_time_string()} {fmt % args}\n")


def serve(port):
    ThreadingHTTPServer((HOST, port), Handler).serve_forever()


def main(argv):
    args = list(argv)
    if len(args) == 2 and args[0] == "--serve" and args[1].isdigit():
        return serve(int(args[1]))
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return
    if args == ["--stop"]:
        return stop()
    if args == ["--status"]:
        state = running()
        print(url(state["port"]) if state else "dashboard: not running")
        sys.exit(0 if state else 1)

    open_browser = "--no-open" not in args
    args = [a for a in args if a != "--no-open"]
    preferred = DEFAULT_PORT
    if args[:1] == ["--port"] and len(args) == 2 and args[1].isdigit():
        preferred = int(args[1])
        args = []
    if args:
        die(f"bad arguments: {' '.join(argv)}\n\n{__doc__.strip()}")

    state = running()
    if state:
        print(f"dashboard: already running at {url(state['port'])}")
    else:
        state = start(preferred)
        print(f"dashboard: serving {FACTORY} at {url(state['port'])} (stop with factory/bin/dashboard --stop)")
    if open_browser and not webbrowser.open(url(state["port"])):
        print("dashboard: couldn't open a browser; open the URL above")


if __name__ == "__main__":
    main(sys.argv[1:])
